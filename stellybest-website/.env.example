# ===========================================
# STELLY-BEST VENTURES - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git — it contains secrets
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/stellybest_db

# Paystack (get keys from dashboard.paystack.com)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Flutterwave (get keys from dashboard.flutterwave.com)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx

# Email (for order confirmations & notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# JWT Secret (for customer authentication - use a long random string)
JWT_SECRET=replace-this-with-a-very-long-random-string

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500
